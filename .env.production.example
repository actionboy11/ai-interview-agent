# Public HTTPS entry
SITE_ADDRESS=47-76-185-182.sslip.io
DEMO_USERNAME=demo
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your password'
# Keep the single quotes so Docker Compose preserves every $ in the hash.
DEMO_PASSWORD_HASH='$2a$14$replace_with_caddy_hash'

# Stage one (Tasks 1-4 / V1-V2): set all three to bootstrap the matching administrator.
# No default account or password. Clear these after bootstrap; do not print them in preflight.
APP_AUTH_BOOTSTRAP_USERNAME=''
APP_AUTH_BOOTSTRAP_PASSWORD=''
APP_AUTH_BOOTSTRAP_DISPLAY_NAME=''
# V3: existing legacy-data owner. Empty is allowed only when there are no legacy root rows.
# Keep single quotes: Compose must preserve literal $ and ${...} in usernames.
# An apostrophe inside a single-quoted dotenv value is escaped as \' (for example O\'Brien).
APP_LEGACY_OWNER_USERNAME=''

# PostgreSQL
POSTGRES_DB=interview_guide
POSTGRES_USER=interview
POSTGRES_PASSWORD=change_me_random_postgres_secret

# RabbitMQ
RABBITMQ_USERNAME=interview
RABBITMQ_PASSWORD=change_me_random_rabbitmq_secret

# MinIO
MINIO_ROOT_USER=interview_storage
MINIO_ROOT_PASSWORD=change_me_random_minio_secret
APP_STORAGE_BUCKET=interview-guide

# AI configuration
AI_BAILIAN_API_KEY=change_me_dashscope_api_key
AI_MODEL=qwen3.5-flash
APP_AI_CONFIG_ENCRYPTION_KEY=change_me_random_encryption_key

# Production transport selection
APP_RESUME_MESSAGING_PROVIDER=rabbitmq
APP_VOICE_EVALUATION_MESSAGING_PROVIDER=rabbitmq
APP_INTERVIEW_EVALUATION_MESSAGING_PROVIDER=rabbitmq
APP_KNOWLEDGE_VECTORIZATION_MESSAGING_PROVIDER=rabbitmq
